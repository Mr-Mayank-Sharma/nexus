# Nexus OMS Environment Configuration
# SECURITY: No secrets have default values. Generate strong unique values for each environment.
# Copy this file to .env and fill in ALL required values before starting the application.

# =============================================================================
# LOCAL LAPTOP RUN (scripts/nexus-local.sh start | stop | restart | reset)
# =============================================================================
# NEXUS_DB_URL=jdbc:postgresql://localhost:5544/nexus_oms
# NEXUS_DB_USERNAME=nexus
# NEXUS_DB_PASSWORD=
# NEXUS_JWT_SECRET=            # openssl rand -base64 48
# APP_CREDENTIAL_ENCRYPTION_KEY=   # openssl rand -base64 24
# PORT=8080
# NEXUS_FRONTEND_PORT=5173
#
# First company and admin, created on the first start when the database is empty.
# The password needs upper and lower case, a digit and one of @#$%^&+=!
# NEXUS_COMPANY_NAME="My Company"
# NEXUS_ADMIN_USERNAME=admin
# NEXUS_ADMIN_PASSWORD=
# NEXUS_ADMIN_EMAIL=
#
# AI: ollama = local model, nothing leaves the machine; anthropic = Claude
# NEXUS_AI_PROVIDER=ollama
# NEXUS_AI_OLLAMA_BASE_URL=http://localhost:11434
# NEXUS_AI_MODEL_OPERATIONS=qwen2.5-coder:3b
# NEXUS_AI_MODEL_EXCEPTIONS=qwen2.5-coder:3b
# NEXUS_AI_MODEL_ROUTING=qwen2.5-coder:3b
# ANTHROPIC_API_KEY=
#
# Shopify, connected on start-up: the store domain with an Admin API token (shpat_...), or a client id and secret
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
#
# BigCommerce, connected on start-up
# BIGCOMMERCE_STORE_HASH=
# BIGCOMMERCE_ACCESS_TOKEN=
# BIGCOMMERCE_CLIENT_ID=

# =============================================================================
# DEPLOYED IMAGE COORDINATES (docker-compose.prod.yml)
# =============================================================================
# These decide which GHCR image `docker compose pull` fetches. You normally do
# NOT set these by hand: the CD deploy jobs upsert both keys into the server's
# .env on every run (see .github/workflows/cd.yml) so production always runs the
# exact tag that pipeline just built.
# Leave both blank for a local `--build` run, or set them to pin a release:
#   NEXUS_IMAGE_OWNER=mr-mayank-sharma     # lowercase ghcr owner, no ghcr.io/ prefix
#   NEXUS_IMAGE_TAG=sha-1a2b3c4d           # or a release tag, e.g. v1.4.0
# If both are unset, compose falls back to ghcr.io/nexus/*:latest — every build
# overwrites :latest, so never rely on it for a real deploy or a rollback.

# =============================================================================
# DATABASE (Required - no defaults)
# =============================================================================
DB_PASSWORD=
# Optional: Override DB connection
# NEXUS_DB_URL=jdbc:postgresql://localhost:5433/nexus_oms
# NEXUS_DB_USERNAME=nexus

# =============================================================================
# JWT AUTHENTICATION (Required - no defaults)
# Generate with: openssl rand -base64 48
# Must be at least 32 characters
# =============================================================================
JWT_SECRET=

# =============================================================================
# CREDENTIAL ENCRYPTION (Required - no defaults, >= 16 chars)
# Encrypts integration-store credentials (Shopify, BigCommerce, etc.) at rest.
# Generate with: openssl rand -base64 24
# =============================================================================
APP_CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# REGISTRATION (Optional - prod disables anonymous sign-ups)
# Set APP_REGISTRATION_ENABLED=true temporarily to create the first admin,
# then remove it and restart. Default: false
# =============================================================================
# APP_REGISTRATION_ENABLED=false

# =============================================================================
# REDIS (Required for caching, sessions)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: REDIS_PASSWORD=
# Optional: REDIS_SSL=false

# =============================================================================
# KAFKA (Required for event streaming)
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Optional: KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Optional: KAFKA_SASL_MECHANISM=PLAIN
# Optional: KAFKA_SASL_JAAS_CONFIG=

# =============================================================================
# AI SERVICES (Required for AI features)
# =============================================================================
AI_OPS_URL=http://localhost:5000
AI_INTEL_URL=http://localhost:5001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# CARRIER API CREDENTIALS (Required for shipping)
# =============================================================================
# FedEx
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
# UPS
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
# USPS
USPS_USER_ID=
USPS_PASSWORD=
# DHL
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=

# =============================================================================
# GRAFANA (Required for monitoring)
# =============================================================================
GRAFANA_ADMIN_PASSWORD=

# =============================================================================
# CORS (Required for frontend)
# Comma-separated list of allowed origins
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# S3 / MINIO (Required for document storage, labels)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexus-shipping-labels
S3_REGION=us-east-1

# =============================================================================
# SSO PROVIDERS (Optional - for OAuth2/SSO login)
# =============================================================================
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Okta
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=
# Auth0
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=

# =============================================================================
# ADMIN USER (Required for seed scripts)
# =============================================================================
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=

# =============================================================================
# APPLICATION SETTINGS (Optional - have defaults)
# =============================================================================
# Spring profiles: default, ai, prod
SPRING_PROFILES_ACTIVE=default
# Server port
PORT=8080
# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:5173
# Enable AI features
NEXUS_AI_ENABLED=false
# Kafka listener auto-start
NEXUS_KAFKA_LISTENER_AUTO_START=true
# Redis health check in actuator
NEXUS_REDIS_HEALTH_ENABLED=false
# S3 enabled
NEXUS_S3_ENABLED=false
# Cache enabled
NEXUS_CACHE_ENABLED=false
# Flyway baseline on migrate
FLYWAY_BASELINE_ON_MIGRATE=true

# =============================================================================
# DEVELOPMENT ONLY - DO NOT USE IN PRODUCTION
# =============================================================================
# For local development, you can use these defaults:
# DB_PASSWORD=dev_password_change_in_prod
# JWT_SECRET=dev_jwt_secret_change_in_prod_must_be_32_chars_minimum
# GRAFANA_ADMIN_PASSWORD=admin123
# NEXUS_ADMIN_PASSWORD=dev_admin_change_in_prod
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# REDIS_HOST=localhost
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# AI_OPS_URL=http://localhost:5000
# AI_INTEL_URL=http://localhost:5001
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
