---
/**
 * The hero: orders arrive from real channels, meet Nexus in the middle, and each one is sent to one location with the
 * reason, while a log underneath says it in words. Invented orders; the decisions are the kind Nexus makes.
 * SVG + a small script; a still frame when the visitor prefers reduced motion.
 */
const CHANNELS = ['Shopify', 'Amazon', 'WooCommerce', 'BigCommerce', 'Walmart', 'Store POS', 'B2B portal', 'Any API'];
const LOCS = [
  { name: 'Warehouse · East', stock: 41 },
  { name: 'Store · New York', stock: 6 },
  { name: 'Store · Boston', stock: 9 },
  { name: '3PL · Dallas', stock: 28 },
];
const W = 660, H = 500, HUB = { x: 330, y: 250 };
const chY = (i: number) => 52 + i * 57;
const locY = (i: number) => 92 + i * 106;
const path = (x1: number, y1: number, x2: number, y2: number) => `M${x1} ${y1} C ${(x1 + x2) / 2} ${y1}, ${(x1 + x2) / 2} ${y2}, ${x2} ${y2}`;
---
<figure class="sb" aria-label="Orders from every channel go through Nexus, which sends each one to the location that can ship it" data-sb>
  <svg viewBox={`0 0 ${W} ${H}`} class="sb__svg" role="img" aria-hidden="true">
    <defs>
      <radialGradient id="sbHub"><stop offset="0" stop-color="#ff5b2e" stop-opacity=".35" /><stop offset="1" stop-color="#ff5b2e" stop-opacity="0" /></radialGradient>
    </defs>
    {CHANNELS.map((_, i) => <path class="sb__wire" id={`sb-in-${i}`} d={path(150, chY(i), HUB.x - 46, HUB.y)} />)}
    {LOCS.map((_, i) => <path class="sb__wire sb__wire--out" id={`sb-out-${i}`} d={path(HUB.x + 46, HUB.y, 474, locY(i))} />)}

    {CHANNELS.map((c, i) => (
      <g class="sb__ch" data-sb-ch={i} transform={`translate(14 ${chY(i) - 17})`}>
        <rect width="136" height="34" rx="10" />
        <circle cx="16" cy="17" r="4" />
        <text x="28" y="22">{c}</text>
      </g>
    ))}

    <circle cx={HUB.x} cy={HUB.y} r="92" fill="url(#sbHub)" class="sb__halo" />
    <circle cx={HUB.x} cy={HUB.y} r="46" class="sb__hub" data-sb-hub />
    <circle cx={HUB.x} cy={HUB.y} r="56" class="sb__ring" />
    <text x={HUB.x} y={HUB.y + 7} text-anchor="middle" class="sb__hubtext">Nexus</text>
    <g class="sb__decide" data-sb-decide transform={`translate(${HUB.x - 92} ${HUB.y + 70})`}>
      <rect width="184" height="46" rx="10" />
      <text x="92" y="19" text-anchor="middle" data-sb-d1>Checking stock…</text>
      <text x="92" y="36" text-anchor="middle" class="sb__small" data-sb-d2>at every location</text>
    </g>

    {LOCS.map((l, i) => (
      <g class="sb__loc" data-sb-loc={i} transform={`translate(474 ${locY(i) - 34})`}>
        <rect width="172" height="68" rx="12" />
        <text x="14" y="26" class="sb__locname">{l.name}</text>
        <text x="14" y="50" class="sb__small"><tspan data-sb-stock={i}>{l.stock}</tspan> in stock · <tspan data-sb-count={i}>0</tspan> orders</text>
      </g>
    ))}
    <g data-sb-dots></g>
  </svg>
  <figcaption class="sb__log" aria-live="off">
    <span class="sb__logtitle">Live decisions <i>(invented orders)</i></span>
    <ol data-sb-log>
      <li><b>#4821</b> Shopify → Warehouse · East <span>holds the whole order</span></li>
    </ol>
  </figcaption>
</figure>

<style>
  .sb { margin: 0; position: relative; }
  .sb__svg { width: 100%; height: auto; overflow: visible; }
  .sb__wire { fill: none; stroke: color-mix(in srgb, var(--fg) 14%, transparent); stroke-width: 1.5; }
  .sb__wire.is-hot { stroke: var(--signal); stroke-width: 2; }
  .sb__ch rect { fill: var(--paper-2); stroke: var(--line); }
  .sb__ch circle { fill: color-mix(in srgb, var(--fg) 25%, transparent); transition: fill 0.3s; }
  .sb__ch.is-hot rect { stroke: var(--signal); }
  .sb__ch.is-hot circle { fill: var(--signal); }
  .sb__ch text { font: 600 13.5px var(--text); fill: var(--fg); }
  .sb__hub { fill: var(--ink); transition: transform 0.3s; transform-origin: 330px 250px; }
  .sb__hub.is-busy { transform: scale(1.06); }
  .sb__ring { fill: none; stroke: var(--signal); stroke-width: 1.5; stroke-dasharray: 3 7; animation: sbSpin 18s linear infinite; transform-origin: 330px 250px; }
  .sb__hubtext { font: italic 500 21px var(--display); fill: #fff; }
  .sb__decide rect { fill: var(--ink); }
  .sb__decide text { font: 600 12.5px var(--text); fill: #fff; }
  .sb__decide .sb__small { fill: #ffb49c; font-weight: 500; }
  .sb__loc rect { fill: var(--paper-2); stroke: var(--line); transition: stroke 0.3s, fill 0.3s; }
  .sb__loc.is-hot rect { stroke: var(--go); fill: color-mix(in srgb, var(--go) 8%, var(--paper-2)); }
  .sb__locname { font: 600 14px var(--text); fill: var(--fg); }
  .sb__small { font: 500 12px var(--text); fill: var(--muted); }
  .sb__dot { fill: var(--signal); }
  .sb__log { margin-top: 10px; padding: 14px 16px; border-radius: 14px; background: var(--paper-2); border: 1px solid var(--line); font-size: 0.9rem; }
  .sb__logtitle { display: block; font-weight: 600; margin-bottom: 6px; }
  .sb__logtitle i { font-weight: 400; color: var(--muted); }
  .sb__log ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; min-height: 4.6em; }
  .sb__log li { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; color: var(--fg); animation: sbIn 0.5s var(--ease); }
  .sb__log li b { font-family: var(--mono); font-weight: 600; font-size: 0.82rem; }
  .sb__log li span { color: var(--go); font-size: 0.84rem; font-weight: 600; }
  .sb__log li span::before { content: '· '; color: var(--muted); }
  @keyframes sbSpin { to { transform: rotate(360deg); } }
  @keyframes sbIn { from { opacity: 0; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .sb__ring { animation: none; } .sb__log li { animation: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-sb]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const svgNS = 'http://www.w3.org/2000/svg';
    const dots = root.querySelector('[data-sb-dots]')!;
    const hub = root.querySelector('[data-sb-hub]')!;
    const d1 = root.querySelector('[data-sb-d1]')!, d2 = root.querySelector('[data-sb-d2]')!;
    const log = root.querySelector('[data-sb-log]')!;
    const ins = Array.from(root.querySelectorAll<SVGPathElement>('[id^="sb-in-"]'));
    const outs = Array.from(root.querySelectorAll<SVGPathElement>('[id^="sb-out-"]'));
    const chs = Array.from(root.querySelectorAll<SVGGElement>('[data-sb-ch]'));
    const locs = Array.from(root.querySelectorAll<SVGGElement>('[data-sb-loc]'));
    const stock = [41, 6, 9, 28], counts = [0, 0, 0, 0];
    const NAMES = ['Shopify', 'Amazon', 'WooCommerce', 'BigCommerce', 'Walmart', 'Store POS', 'B2B portal', 'Any API'];
    const LOC = ['Warehouse · East', 'Store · New York', 'Store · Boston', '3PL · Dallas'];
    const REASONS = ['holds the whole order', 'nearest with stock', 'one parcel, not two', 'store rarely misses a pick', 'ships today before cut-off'];
    let n = 4822, visible = true, timer = 0;

    const travel = (p: SVGPathElement, ms: number, done: () => void) => {
      const dot = document.createElementNS(svgNS, 'circle');
      dot.setAttribute('r', '6'); dot.setAttribute('class', 'sb__dot'); dots.appendChild(dot);
      const len = p.getTotalLength(), t0 = performance.now();
      p.classList.add('is-hot');
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / ms), e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        const pt = p.getPointAtLength(e * len);
        dot.setAttribute('cx', String(pt.x)); dot.setAttribute('cy', String(pt.y));
        if (k < 1) requestAnimationFrame(step); else { dot.remove(); p.classList.remove('is-hot'); done(); }
      };
      requestAnimationFrame(step);
    };

    const one = () => {
      if (!visible || document.hidden) return;
      const c = Math.floor(Math.random() * NAMES.length);
      // the B2B portal's big orders go to the warehouse; others mostly to whoever has stock
      let l = c === 6 ? 0 : Math.floor(Math.random() * LOC.length);
      if (stock[l] < 2) l = 0;
      const id = n++, reason = c === 6 ? 'holds the whole order' : REASONS[Math.floor(Math.random() * REASONS.length)];
      chs[c].classList.add('is-hot');
      travel(ins[c], 1100, () => {
        chs[c].classList.remove('is-hot');
        hub.classList.add('is-busy');
        d1.textContent = `#${id} → ${LOC[l]}`;
        d2.textContent = reason;
        setTimeout(() => {
          hub.classList.remove('is-busy');
          travel(outs[l], 1000, () => {
            stock[l] = Math.max(1, stock[l] - 1); counts[l]++;
            locs[l].classList.add('is-hot');
            root.querySelector(`[data-sb-stock="${l}"]`)!.textContent = String(stock[l]);
            root.querySelector(`[data-sb-count="${l}"]`)!.textContent = String(counts[l]);
            setTimeout(() => locs[l].classList.remove('is-hot'), 700);
            const li = document.createElement('li');
            li.innerHTML = `<b>#${id}</b> ${NAMES[c]} → ${LOC[l]} <span>${reason}</span>`;
            log.prepend(li);
            while (log.children.length > 3) log.lastElementChild!.remove();
          });
        }, 450);
      });
    };
    const start = () => { if (!timer) { one(); timer = window.setInterval(one, 1500); } };
    const stop = () => { clearInterval(timer); timer = 0; };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(root);
  }
</script>
