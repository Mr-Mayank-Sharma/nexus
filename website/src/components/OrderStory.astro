---
/**
 * "The life of an order": the signature scroll film. A real-time 3D world (src/lib/orderWorld.ts) follows order
 * #4821 from the moment it is placed on any channel to the truck leaving the dock and out to the planet, while the
 * captions say what Nexus does at each step and how real that step is today. A HUD runs the order's clock and the one
 * number each chapter is about. Without JS, or with reduced motion, the steps read as a list.
 */
import { CHANNELS, CHAPTERS } from '../lib/orderStory';

type Tag = 'live' | 'built' | 'next';
const TAG: Record<Tag, { label: string; cls: string }> = {
  live: { label: 'Verified live', cls: 'os__tag--live' },
  built: { label: 'Built', cls: 'os__tag--built' },
  next: { label: 'Coming next', cls: 'os__tag--next' },
};
const chapters: { status: string; title: string; body: string; tags: [Tag, string][] }[] = [
  { status: 'Placed', title: 'A customer orders. On any channel.',
    body: 'Storefronts, marketplaces, stores and B2B partners all send orders the same way: Nexus takes the order data over each platform\'s API.',
    tags: [['live', 'Shopify, BigCommerce'], ['built', 'Any JSON API through generic connections'], ['built', 'EDI 850']] },
  { status: 'In Nexus', title: 'Nexus already knows the real stock',
    body: 'Stock arrives from your ERP and your stores\' POS and is kept as a ledger per location. Safety thresholds come off first, so Nexus only promises what can really ship.',
    tags: [['built', 'ERP and POS stock import'], ['built', 'Safety stock and sellable per location']] },
  { status: 'Approved', title: 'Checked before anyone touches it',
    body: 'Approval rules check the order (value limits, first orders, block lists) and either pass it, hold it for a person, or reject it.',
    tags: [['built', 'Rule-based approval'], ['next', 'AI risk scoring']] },
  { status: 'Scheduled', title: 'The ship date decides when work starts',
    body: 'A B2C order ships today, so its stock is reserved at once. A B2B order may ship in two months: reserving now would starve other orders, so it waits and is released a few days before its ship date.',
    tags: [['built', 'Reserve on allocation (B2C)'], ['built', 'B2B release window by ship date']] },
  { status: 'In a wave', title: 'Orders become a pick wave',
    body: 'Released orders are grouped into a wave with one walking route and handed to a picker, with every bin location already reserved.',
    tags: [['built', 'Waves and pick lists']] },
  { status: 'Picked', title: 'The picker goes straight to the bins',
    body: 'The picker walks the route, scans each bin and puts each item in the tote. If a bin is empty, the order re-routes whole to another location.',
    tags: [['built', 'Pick tasks and re-route on reject']] },
  { status: 'Packed', title: 'The right box, before anyone guesses',
    body: 'At packing, Nexus recommends the box size and count from the items\' dimensions. The packer packs, and the shipping label prints for the carrier.',
    tags: [['built', 'Box recommendation'], ['built', 'Labels (carrier APIs not yet run live)']] },
  { status: 'Shipped', title: 'Dispatched. Shipped.',
    body: 'The parcel rides to the dock, the carrier\'s truck takes it, and Nexus marks the order shipped. From here the carrier\'s tracking takes over.',
    tags: [['built', 'Manifests and dispatch']] },
  { status: 'Completed', title: 'Every order. Everywhere.',
    body: 'The same brain for every channel and every location: orders come in from anywhere, and each one leaves from the place that can really ship it.',
    tags: [['built', 'One order system for every channel and location']] },
];
if (chapters.length !== CHAPTERS.length) throw new Error('OrderStory: chapters and CHAPTERS differ');
const total = String(chapters.length).padStart(2, '0');
---
<section class="os" aria-label="The life of an order in Nexus" data-os data-scene-trigger="dark">
  <div class="os__pin">
    <div class="os__canvas" data-os-canvas aria-hidden="true"></div>
    <div class="os__flash os__flash--white" data-os-white aria-hidden="true"></div>
    <div class="os__flash os__flash--black" data-os-black aria-hidden="true"></div>

    <div class="wrap os__top">
      <div class="os__glass os__hud" aria-hidden="true">
        <p class="eyebrow eyebrow--signal" style="margin:0">The life of an order</p>
        <p class="os__step mono"><b data-os-n>01</b> / {total}</p>
        <div class="os__readout">
          <div><span class="mono">Order clock</span><b class="mono" data-os-clock>10:42:01</b></div>
          <div><span class="mono" data-os-label>Channels</span><b class="mono" data-os-value>0</b></div>
        </div>
      </div>
      <div class="os__glass os__ticket" aria-hidden="true">
        <div class="os__ticket-head"><span class="mono">Order #4821</span><span class="mono os__ticket-ch">Shopify · B2C</span></div>
        <ol>{chapters.map((c, i) => <li data-os-st={i}><i></i>{c.status}</li>)}</ol>
      </div>
    </div>

    <div class="wrap os__caps">
      {chapters.map((c, i) => (
        <article class="os__cap os__glass" data-os-cap={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <span class="os__n mono">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="display os__h">{c.title}</h3>
          <p>{c.body}</p>
          <ul class="os__tags">{c.tags.map(([t, s]) => <li class={`os__tag ${TAG[t].cls}`}><b>{TAG[t].label}</b> {s}</li>)}</ul>
        </article>
      ))}
    </div>

    <nav class="os__rail" aria-label="Jump to a step">
      {chapters.map((c, i) => <button type="button" data-os-jump={i} aria-label={`Step ${i + 1}: ${c.title}`}><span>{String(i + 1).padStart(2, '0')}</span></button>)}
      <b data-os-fill></b>
    </nav>
    <p class="os__note mono" aria-hidden="true">Real-time 3D · illustration · invented order · {CHANNELS.length} channels</p>
  </div>
</section>

<style>
  .os { position: relative; background: #04060d; color: var(--text-d); }
  .os__pin { position: relative; height: 100svh; min-height: 600px; overflow: hidden; }
  .os__canvas { position: absolute; inset: 0; }
  .os__canvas :global(canvas) { width: 100%; height: 100%; display: block; }
  .os__flash { position: absolute; inset: 0; pointer-events: none; opacity: 0; z-index: 1; }
  .os__flash--white { background: radial-gradient(circle at 50% 45%, #ffffff 0%, #eaf1ff 45%, #c9d8ff 100%); }
  .os__flash--black { background: #02030a; }
  .os__glass { background: rgba(7, 11, 22, 0.72); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 18px; backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25); }
  .os__top { position: absolute; left: 0; right: 0; top: 90px; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; z-index: 2; }
  .os__hud { padding: 14px 18px; min-width: 250px; }
  .os__step { margin: 6px 0 10px; font-size: 0.8rem; letter-spacing: 0.14em; color: var(--muted-d); }
  .os__step b { color: #fff; font-weight: 600; font-size: 1.5rem; }
  .os__readout { display: grid; gap: 8px; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 10px; }
  .os__readout div { display: flex; justify-content: space-between; align-items: baseline; gap: 18px; }
  .os__readout span { font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-d); }
  .os__readout b { font-size: 1.05rem; font-weight: 600; color: #fff; font-variant-numeric: tabular-nums; }
  .os__ticket { width: 230px; padding: 14px 16px; }
  .os__ticket-head { display: flex; justify-content: space-between; font-size: 0.68rem; letter-spacing: 0.08em; color: #fff; margin-bottom: 10px; }
  .os__ticket-ch { color: var(--muted-d); }
  .os__ticket ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; }
  .os__ticket li { display: flex; align-items: center; gap: 10px; font-size: 0.78rem; color: #4d586e; transition: color 0.3s; }
  .os__ticket li i { width: 8px; height: 8px; border-radius: 50%; background: #2a3347; transition: background 0.3s, box-shadow 0.3s; }
  .os__ticket li.done { color: #c7d0e0; }
  .os__ticket li.done i { background: var(--go); }
  .os__ticket li.now { color: #fff; font-weight: 600; }
  .os__ticket li.now i { background: var(--ember); box-shadow: 0 0 0 4px rgba(255, 138, 76, 0.25); }
  .os__caps { position: absolute; left: 0; right: 0; bottom: 84px; z-index: 2; pointer-events: none; }
  .os__cap { position: absolute; left: var(--gutter); bottom: 0; max-width: 500px; padding: 22px 24px; opacity: 0; transform: translateY(26px) scale(0.98); transition: opacity 0.45s var(--ease), transform 0.6s var(--ease); }
  .os__cap[aria-hidden='false'] { opacity: 1; transform: none; pointer-events: auto; }
  .os__n { color: var(--ember); font-size: 0.8rem; letter-spacing: 0.14em; }
  .os__h { font-size: clamp(1.4rem, 2.6vw, 2.2rem); margin: 8px 0 12px; }
  .os__cap p { margin: 0; color: #c9d1df; font-size: 0.98rem; max-width: 46ch; }
  .os__tags { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .os__tag { font-size: 0.74rem; padding: 6px 11px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.04); color: #c7d0e0; }
  .os__tag b { font-family: var(--mono); font-weight: 600; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; margin-right: 4px; }
  .os__tag--live b { color: var(--go); } .os__tag--built b { color: var(--signal-2); } .os__tag--next b { color: var(--warn); }
  .os__rail { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 30px; z-index: 3; display: flex; gap: 6px; }
  .os__rail button { flex: 1; height: 26px; position: relative; padding: 0; background: none; cursor: pointer; }
  .os__rail button::before { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: rgba(128, 140, 165, 0.35); }
  .os__rail button span { position: absolute; left: 0; bottom: 8px; font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.1em; color: #7c879c; mix-blend-mode: difference; }
  .os__rail button:hover span, .os__rail button:focus-visible span { color: #fff; }
  .os__rail b { position: absolute; left: 0; bottom: 0; height: 2px; width: 0; background: linear-gradient(90deg, var(--signal), var(--ember)); pointer-events: none; }
  .os__note { position: absolute; right: var(--gutter); bottom: 64px; margin: 0; font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; color: #7c879c; z-index: 2; mix-blend-mode: difference; }
  @media (max-width: 900px) {
    .os__top { top: 80px; }
    .os__hud { min-width: 0; padding: 10px 12px; }
    .os__readout b { font-size: 0.9rem; }
    .os__ticket { width: 170px; padding: 10px 12px; }
    .os__ticket li { font-size: 0.68rem; }
    .os__ticket-ch { display: none; }
    .os__caps { bottom: 70px; }
    .os__cap { right: var(--gutter); max-width: none; padding: 16px 18px; }
    .os__cap p { font-size: 0.9rem; }
    .os__note { display: none; }
  }
  @media (max-width: 600px) {
    .os__ticket { width: auto; padding: 8px 12px; }
    .os__ticket-head { margin-bottom: 4px; }
    .os__ticket li:not(.now) { display: none; }
    .os__readout div:first-child { display: none; }
    .os__step { margin: 2px 0 6px; }
  }
  /* no JS, or reduced motion: the steps as a readable list */
  :global(html:not(.js)) .os__pin, .os.is-static .os__pin { height: auto; min-height: 0; padding: 110px 0 60px; }
  :global(html:not(.js)) .os__canvas, :global(html:not(.js)) .os__flash, :global(html:not(.js)) .os__rail, :global(html:not(.js)) .os__top, :global(html:not(.js)) .os__note,
  .os.is-static .os__canvas, .os.is-static .os__flash, .os.is-static .os__rail, .os.is-static .os__top, .os.is-static .os__note { display: none; }
  :global(html:not(.js)) .os__caps, .os.is-static .os__caps { position: static; }
  :global(html:not(.js)) .os__cap, .os.is-static .os__cap { position: static; opacity: 1; transform: none; max-width: 640px; margin: 0 0 24px; }
</style>

<script>
  import { ScrollTrigger, reduced, getLenis } from '../lib/motion';
  import { CHAPTERS, chapterAt, flash, hud } from '../lib/orderStory';

  const root = document.querySelector<HTMLElement>('[data-os]');
  if (root) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const pin = q<HTMLElement>('.os__pin'), host = q<HTMLElement>('[data-os-canvas]');
    const caps = Array.from(root.querySelectorAll<HTMLElement>('[data-os-cap]'));
    const sts = Array.from(root.querySelectorAll<HTMLElement>('[data-os-st]'));
    const num = q<HTMLElement>('[data-os-n]'), fill = q<HTMLElement>('[data-os-fill]');
    const white = q<HTMLElement>('[data-os-white]'), black = q<HTMLElement>('[data-os-black]');
    const clock = q<HTMLElement>('[data-os-clock]'), label = q<HTMLElement>('[data-os-label]'), value = q<HTMLElement>('[data-os-value]');
    const jumps = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-os-jump]'));

    if (reduced()) root.classList.add('is-static');
    else {
      let world: { setProgress(p: number): void } | null = null;
      let progress = 0, current = -1;
      const show = (p: number) => {
        progress = p;
        world?.setProgress(p);
        fill.style.width = `${p * 100}%`;
        const f = flash(p);
        white.style.opacity = String(f.white);
        black.style.opacity = String(f.black);
        const h = hud(p);
        clock.textContent = h.clock; label.textContent = h.label; value.textContent = h.value;
        const c = chapterAt(p);
        const done = p > 0.97 ? sts.length : c;
        sts.forEach((s, i) => { s.classList.toggle('done', i < done || (i === c && p > 0.97)); s.classList.toggle('now', i === c && p <= 0.97); });
        if (c === current) return;
        current = c;
        caps.forEach((cap, i) => cap.setAttribute('aria-hidden', String(i !== c)));
        num.textContent = String(c + 1).padStart(2, '0');
      };

      const st = ScrollTrigger.create({
        trigger: root, start: 'top top', end: () => '+=' + window.innerHeight * (window.innerWidth < 900 ? 11 : 13),
        pin, scrub: true, anticipatePin: 1,
        onUpdate: self => show(self.progress),
      });
      show(0);

      jumps.forEach((b, i) => b.addEventListener('click', () => {
        const y = st.start + (st.end - st.start) * (CHAPTERS[i].from + 0.012);
        const l = getLenis();
        if (l) l.scrollTo(y, { duration: 1.4 }); else window.scrollTo({ top: y, behavior: 'smooth' });
      }));

      // three.js loads only when the film is near
      const io = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        try {
          const { mountOrderWorld } = await import('../lib/orderWorld');
          await document.fonts?.ready;
          world = mountOrderWorld(host, { reduced: false });
        } catch (err) {
          console.warn('Order film could not start; showing the steps as text', err);
        }
        // no WebGL, or the 3D code failed to load: the steps read as a list instead of an empty screen
        if (!world) { root.classList.add('is-static'); st.kill(); ScrollTrigger.refresh(); }
        else world.setProgress(progress);
      }, { rootMargin: '600px' });
      io.observe(root);
    }
  }
</script>
