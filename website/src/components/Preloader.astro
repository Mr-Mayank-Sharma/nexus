---
/**
 * First-visit intro: a dotted world map lights up while a counter runs, with the channels Nexus takes orders from
 * on one side and what it does with them on the other; then the curtain lifts. Once per browser session, never
 * for reduced motion, and only when JS runs (Base.astro adds html.preload before first paint).
 */
const left = ['Shopify', 'BigCommerce', 'Amazon', 'Walmart', 'eBay', 'Magento', 'Shopify POS', 'NetSuite', 'SAP', 'EDI partners'];
const right = ['Order capture', 'Stock per location', 'Order routing', 'Ship from store', 'Pick up in store', 'Re-route on reject', 'Transfers', 'Scheduled jobs', 'Routing what-if', 'Ledger and audit'];
---
<div class="pl" aria-hidden="true">
  <div class="pl__head">
    <span class="pl__brand">Nexus</span>
    <span class="pl__count"><b data-pl-count>00</b><i>%</i></span>
  </div>
  <canvas class="pl__map"></canvas>
  <ul class="pl__col pl__col--l">{left.map(x => <li>{x}</li>)}</ul>
  <ul class="pl__col pl__col--r">{right.map(x => <li>{x}</li>)}</ul>
  <p class="pl__foot">Every channel · every location · one brain</p>
</div>

<style>
  .pl { display: none; }
  :global(html.preload) .pl { display: block; position: fixed; inset: 0; z-index: 300; background: #000; color: #8b97ad; font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; clip-path: inset(0 0 0 0); }
  :global(html.preload) body { overflow: hidden; }
  .pl__head { position: absolute; left: var(--gutter); right: var(--gutter); top: 50%; transform: translateY(-50%); display: flex; justify-content: space-between; align-items: center; z-index: 2; pointer-events: none; }
  .pl__brand { font-family: var(--display); font-weight: 700; font-size: 1rem; letter-spacing: 0.08em; color: #fff; }
  .pl__count { color: #fff; font-size: 0.8rem; }
  .pl__count b { font-weight: 500; }
  .pl__map { position: absolute; left: 50%; top: 50%; width: min(92vw, 980px); aspect-ratio: 2 / 1; transform: translate(-50%, -50%); }
  .pl__col { position: absolute; top: calc(50% + 24px); list-style: none; margin: 0; padding: 0; line-height: 1.75; }
  .pl__col--l { left: var(--gutter); }
  .pl__col--r { right: var(--gutter); text-align: right; }
  .pl__col li { opacity: 0; }
  .pl__col li.on { opacity: 1; color: #c7d0e0; }
  .pl__col li.hot { color: var(--signal); }
  .pl__foot { position: absolute; left: 0; right: 0; bottom: 28px; text-align: center; margin: 0; }
  @media (max-width: 700px) { .pl__col { display: none; } }
</style>

<script>
  import LAND from '../data/land.json';
  const root = document.querySelector<HTMLElement>('.pl');
  const html = document.documentElement;
  if (root && html.classList.contains('preload')) {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const count = root.querySelector<HTMLElement>('[data-pl-count]')!;
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('.pl__col li'));
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const size = () => { const r = canvas.getBoundingClientRect(); canvas.width = r.width * dpr; canvas.height = r.height * dpr; };
    size();
    // dots in a random order, so the map "boots up" rather than wipes
    const dots = (LAND as [number, number][]).map(([lon, lat]) => ({ x: (lon + 180) / 360, y: (90 - lat) / 180, r: Math.random() }));
    dots.sort((a, b) => a.r - b.r);
    const hubs = [[-74, 40.7], [-118.2, 34], [4.5, 51.9], [103.8, 1.35], [72.9, 19.1], [151.2, -33.9]].map(([lon, lat]) => ({ x: (lon + 180) / 360, y: (90 - lat) / 180 }));
    const T = 2100, t0 = performance.now();
    const draw = (p: number) => {
      const w = canvas.width, h = canvas.height, n = Math.floor(dots.length * Math.min(1, p * 1.15));
      ctx.clearRect(0, 0, w, h);
      const s = 1.15 * dpr;
      for (let i = 0; i < n; i++) {
        const d = dots[i];
        ctx.fillStyle = i > n - 40 ? '#ffffff' : 'rgba(150,165,190,0.55)';
        ctx.fillRect(d.x * w - s / 2, d.y * h - s / 2, s, s);
      }
      hubs.forEach((c, k) => {
        if (p < 0.25 + k * 0.1) return;
        ctx.fillStyle = k % 2 ? '#5b8cff' : '#ff8a4c';
        ctx.beginPath(); ctx.arc(c.x * w, c.y * h, 3.2 * dpr, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = 'rgba(91,140,255,0.35)'; ctx.lineWidth = dpr;
        const pulse = ((performance.now() / 900) + k * 0.3) % 1;
        ctx.beginPath(); ctx.arc(c.x * w, c.y * h, (4 + pulse * 18) * dpr, 0, Math.PI * 2); ctx.globalAlpha = 1 - pulse; ctx.stroke(); ctx.globalAlpha = 1;
      });
    };
    const finish = () => {
      try { sessionStorage.setItem('nx-intro', '1'); } catch { /* private mode: the intro may show again, which is fine */ }
      root.animate([{ clipPath: 'inset(0 0 0 0)' }, { clipPath: 'inset(0 0 100% 0)' }], { duration: 900, easing: 'cubic-bezier(.77,0,.18,1)', fill: 'forwards' })
        .finished.then(() => { html.classList.remove('preload'); root.remove(); window.dispatchEvent(new Event('nx:intro-done')); });
    };
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / T);
      const eased = 1 - Math.pow(1 - p, 2.2);
      count.textContent = String(Math.floor(eased * 100)).padStart(2, '0');
      const k = Math.floor(eased * items.length);
      items.forEach((li, i) => { li.classList.toggle('on', i < k + 1); li.classList.toggle('hot', i === k); });
      draw(eased);
      if (p < 1) requestAnimationFrame(tick); else setTimeout(finish, 250);
    };
    requestAnimationFrame(tick);
  } else root?.remove();
</script>
