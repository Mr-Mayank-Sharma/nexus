---
/** What an order system does, in six plain steps anyone can follow. */
const steps = [
  { t: 'An order arrives', b: 'From your website, a marketplace, a store till or a business customer. All of them land in one place.', icon: 'cart' },
  { t: 'Nexus checks real stock', b: 'It knows what every warehouse and store really holds, minus a safety buffer, so it never promises what is not there.', icon: 'stock' },
  { t: 'It checks the order', b: 'Payment, address and your rules. Anything odd is held for a person instead of being shipped.', icon: 'check' },
  { t: 'It picks the best place to ship from', b: 'One location that holds the whole order if possible, the nearest, and one that rarely misses a pick.', icon: 'route' },
  { t: 'The warehouse or store packs it', b: 'Pickers get a list with exact shelf locations; packers get the right box size and a printed label.', icon: 'box' },
  { t: 'It ships, and everyone knows', b: 'Tracking goes back to the channel and the customer, and stock is updated everywhere at once.', icon: 'truck' },
];
const ICONS: Record<string, string> = {
  cart: 'M4 6h2l2 10h10l2-7H7.2 M9 20h.01 M17 20h.01',
  stock: 'M4 20V10 M10 20V4 M16 20v-7 M22 20H2',
  check: 'M5 12l4 4 10-10',
  route: 'M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M19 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M7 17h6a4 4 0 0 0 0-8h-2 M17 7h-4',
  box: 'M3 8l9-5 9 5v8l-9 5-9-5z M3 8l9 5 9-5 M12 13v8',
  truck: 'M2 7h11v9H2z M13 10h5l3 3v3h-8 M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
};
---
<ol class="steps">
  {steps.map((s, i) => (
    <li class="steps__item" data-reveal data-delay={String((i % 3) * 0.08)}>
      <div class="steps__top">
        <span class="steps__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ICONS[s.icon]} /></svg>
        </span>
        <span class="steps__n">{i + 1}</span>
      </div>
      <h3>{s.t}</h3>
      <p>{s.b}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 2vw, 24px); counter-reset: s; }
  .steps__item { position: relative; padding: 24px; border-radius: var(--r); background: var(--paper-2); border: 1px solid var(--line); }
  .steps__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .steps__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: color-mix(in srgb, var(--signal) 12%, transparent); color: var(--signal); }
  .steps__n { font-family: var(--display); font-style: italic; font-size: 2rem; line-height: 1; color: color-mix(in srgb, var(--fg) 25%, transparent); }
  .steps__item h3 { margin: 0 0 8px; font-size: 1.15rem; font-weight: 650; }
  .steps__item p { margin: 0; color: var(--muted); }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .steps { grid-template-columns: 1fr; } }
</style>
