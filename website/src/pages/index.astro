---
import Base from '../layouts/Base.astro';
import Switchboard from '../components/Switchboard.astro';
import Steps from '../components/Steps.astro';
import OrderStory from '../components/OrderStory.astro';
import WhatIfDemo from '../components/WhatIfDemo.astro';
import ProductFilm from '../components/ProductFilm.astro';
import PromiseSection from '../components/PromiseSection.astro';
import CapGallery from '../components/CapGallery.astro';
import TourVideo from '../components/TourVideo.astro';
import ChannelGrid from '../components/ChannelGrid.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../site.config';
import { AUDIENCE, FAQ } from '../data/content';
import { POSTS } from '../data/posts';

const statement = 'Most cancelled orders start the same way: a system promised stock that a location did not have.';
const why = [
  { t: 'Per location, not per total', b: 'Most channels check oversell against total stock. Nexus keeps and publishes each location\'s own number.' },
  { t: 'Learns which stores miss picks', b: 'Each store\'s pick-failure rate, from your own rejections, counts against it when routing.' },
  { t: 'Holds B2B orders until it is time', b: 'Orders that ship in weeks reserve nothing until their release date, so this week\'s orders get the stock.' },
  { t: 'Proves a rule before it goes live', b: 'Replay past orders under a new rule and see shipments, splits and failed picks first.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base scene="dark">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <section class="hero hero--dark" data-scene-trigger="dark" id="top">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__canvas" id="net" aria-hidden="true"></div>
    <div class="wrap hero__copy">
      <a class="hero__pill" href="/release-by-ship-date" data-reveal><b>New</b> B2B orders wait for their ship date <span aria-hidden="true">→</span></a>
      <h1 class="display h-xl" style="margin-top:24px;max-width:11ch" data-split>One brain for every order</h1>
      <p class="hero__sub" data-reveal data-delay="0.25">{site.description}</p>
      <div class="hero__cta" data-reveal data-delay="0.35">
        <a class="btn btn--signal" href="/contact">Book a demo <span class="arr">→</span></a>
        <a class="btn hero__ghost" href="#how">See how it works</a>
      </div>
      <ul class="hero__proof" data-reveal data-delay="0.45">
        <li><b>5,052</b> orders imported, totals equal to the cent</li>
        <li><b>2</b> storefronts verified live, plus any JSON API</li>
        <li><b>1,206</b> automated tests before each release</li>
      </ul>
    </div>
    <div class="hero__legend" aria-hidden="true"><span><i style="background:#ff5b2e"></i>Warehouse</span><span><i style="background:#f6efe2"></i>Store</span><span><i style="background:#ffb49c"></i>Order in motion</span></div>
  </section>

  <section class="section" id="how" data-scene-trigger="light" aria-labelledby="how-h">
    <div class="wrap">
      <div class="grid g2" style="align-items:end;margin-bottom:clamp(32px,4vw,52px)">
        <div>
          <p class="eyebrow eyebrow--signal">In plain words</p>
          <h2 id="how-h" class="display h-lg" style="margin-top:14px">What an order system <em>actually</em> does</h2>
        </div>
        <p class="lead">From the moment someone clicks "buy" to the moment the parcel leaves, six things have to go right. Nexus does each of them, the same way for every channel and every location.</p>
      </div>
      <div class="how__board" data-reveal><Switchboard /></div>
      <Steps />
    </div>
  </section>

  <section class="section--tight" data-scene-trigger="light">
    <div class="wrap">
      <p class="statement" data-statement>{statement}</p>
      <div class="grid g2" style="margin-top:clamp(32px,5vw,64px);align-items:end">
        <p class="lead" data-reveal>Stock fed in once a day goes stale by lunchtime. Line-by-line routing splits one order into two parcels. A marketplace sells what a store already sold. A wholesale order placed months ahead locks away this week's stock. Each of these is fixable.</p>
        <div data-reveal><a class="link-arrow" href="/use-cases/stop-overselling">How Nexus stops overselling →</a></div>
      </div>
    </div>
  </section>

  <OrderStory />

  <PromiseSection />

  <ProductFilm />

  <CapGallery />

  <TourVideo />

  <section class="section" data-scene-trigger="dark" aria-labelledby="wi-h">
    <div class="wrap">
      <div class="grid g2" style="align-items:end;margin-bottom:40px">
        <div>
          <p class="eyebrow eyebrow--signal">Try it</p>
          <h2 id="wi-h" class="display h-lg" style="margin-top:14px">Change a rule. <em>Watch the orders move.</em></h2>
        </div>
        <p class="lead" data-reveal>This is the routing replay from the product, running in your browser on invented orders. Make the New York store less reliable, or shipping dearer, and see which rule wins.</p>
      </div>
      <div data-reveal><WhatIfDemo /></div>
      <p style="margin-top:26px"><a class="link-arrow" href="/what-if">Run it on your own orders →</a></p>
    </div>
  </section>

  <section class="section" data-scene-trigger="light" aria-labelledby="why-h">
    <div class="wrap">
      <p class="eyebrow">Why Nexus</p>
      <h2 id="why-h" class="display h-lg" style="margin:14px 0 clamp(32px,5vw,56px);max-width:18ch">Built for the store that <em>can't find the jacket</em></h2>
      <div class="grid g4">
        {why.map((w, i) => (
          <div class="why" data-reveal data-delay={String(i * 0.08)}>
            <span class="why__i">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h-sm" style="margin:14px 0 10px;font-weight:650">{w.t}</h3>
            <p class="dim" style="margin:0">{w.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight" data-scene-trigger="light" aria-labelledby="pf-h">
    <div class="wrap">
      <h2 id="pf-h" class="display h-md" style="margin:0 0 28px;max-width:24ch">An order system first. <em>Your warehouse system stays.</em></h2>
      <div class="grid g2">
        <a class="card pf pf--on" href="/product/order-routing" data-reveal>
          <span class="chip chip--go">Available now</span>
          <h3 class="display h-md" style="margin:16px 0 10px">Nexus OMS</h3>
          <p>Orders from every channel, stock per location, routing, store fulfilment, B2B release by ship date, returns to stock, and the connections to your storefronts, marketplaces, ERP and POS.</p>
          <span class="link-arrow" style="margin-top:18px;display:inline-block">Explore the OMS →</span>
        </a>
        <a class="card pf" href="/wms" data-reveal data-delay="0.08">
          <span class="chip chip--dim">Coming 2027</span>
          <h3 class="display h-md" style="margin:16px 0 10px">Nexus WMS</h3>
          <p>A warehouse system designed from time on real warehouse floors. Until then, Nexus OMS hands orders to the warehouse system you already run, and takes back what was picked and shipped.</p>
          <span class="link-arrow" style="margin-top:18px;display:inline-block">Why separate, and what's planned →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" data-scene-trigger="light" aria-labelledby="ch-h">
    <div class="wrap">
      <div class="grid g2" style="align-items:end;margin-bottom:clamp(28px,4vw,48px)">
        <div>
          <p class="eyebrow">Integrations</p>
          <h2 id="ch-h" class="display h-lg" style="margin-top:14px">Every place you <em>sell and stock</em></h2>
        </div>
        <p class="lead" data-reveal>Storefronts, marketplaces, ERP, point of sale, EDI partners and carriers. Each one says what it really is today. Hover a cell for the detail.</p>
      </div>
      <ChannelGrid />
      <p style="margin-top:26px"><a class="link-arrow" href="/integrations">All integrations →</a></p>
    </div>
  </section>

  <section class="section" data-scene-trigger="light" aria-labelledby="aud-h">
    <div class="wrap">
      <p class="eyebrow">Who it is for</p>
      <h2 id="aud-h" class="display h-lg" style="margin:14px 0 clamp(32px,5vw,56px)">Everyone who <em>answers for an order</em></h2>
      <div class="aud">
        {AUDIENCE.map(a => (
          <div class="aud__row" data-reveal>
            <h3 class="display h-sm">{a.who}</h3>
            <p>{a.gets}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight" data-scene-trigger="light" aria-labelledby="offer-h">
    <div class="wrap">
      <div class="offer" data-reveal>
        <div>
          <p class="eyebrow eyebrow--signal">{site.offer.title}</p>
          <h2 id="offer-h" class="display h-md" style="margin:14px 0 16px">Try it on your own orders, <em>free</em></h2>
          <p class="dim" style="margin:0 0 26px;max-width:44ch">{site.offer.summary}</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <a class="btn btn--signal" href="/contact">Apply for the program <span class="arr">→</span></a>
            <a class="btn offer__ghost" href="/pricing">Pricing</a>
          </div>
        </div>
        <ol class="offer__list">
          {site.offer.items.map((it, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><span>{it}</span></li>)}
        </ol>
        <p class="offer__fine">{site.offer.fine}</p>
      </div>
    </div>
  </section>

  <section class="section" data-scene-trigger="light" aria-labelledby="ins-h">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:32px">
        <div><p class="eyebrow">From the blog</p><h2 id="ins-h" class="display h-md" style="margin-top:14px">Ideas for running <em>better orders</em></h2></div>
        <a class="link-arrow" href="/blog">All articles →</a>
      </div>
      <div class="grid g3">
        {POSTS.slice(0, 3).map(p => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <section class="section" data-scene-trigger="light" aria-labelledby="faq-h">
    <div class="wrap grid g2" style="align-items:start">
      <div><p class="eyebrow">Questions</p><h2 id="faq-h" class="display h-md" style="margin-top:14px">Straight answers</h2></div>
      <div class="faq">
        {FAQ.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero--dark { min-height: min(100svh, 940px); display: grid; align-items: end; padding: 130px 0 76px; background: var(--ink); color: var(--text-d); isolation: isolate; }
  .hero__canvas { position: absolute; inset: 0; z-index: -1; }
  .hero__canvas :global(canvas) { width: 100%; height: 100%; }
  .hero__glow { position: absolute; inset: 0; z-index: -2; background: radial-gradient(55% 60% at 78% 50%, rgba(18, 163, 122, 0.28), transparent 62%), radial-gradient(35% 40% at 88% 35%, rgba(255, 91, 46, 0.22), transparent 60%); }
  .hero__copy { max-width: 900px; }
  .hero--dark .hero__sub { color: var(--muted-d); }
  .hero--dark .hero__pill { background: rgba(241, 237, 228, 0.06); border-color: var(--line-d); color: var(--text-d); }
  .hero__ghost { border-color: var(--line-d); color: var(--text-d); }
  .hero__ghost:hover { border-color: var(--text-d); }
  .hero__proof { list-style: none; margin: 40px 0 0; padding: 22px 0 0; border-top: 1px solid var(--line-d); display: flex; flex-wrap: wrap; gap: 14px 38px; color: var(--muted-d); font-size: 0.92rem; }
  .hero__proof b { display: block; font-family: var(--display); font-weight: 450; font-size: 1.9rem; color: var(--text-d); letter-spacing: -0.02em; line-height: 1.1; }
  .hero__legend { position: absolute; right: var(--gutter); bottom: 28px; display: flex; gap: 20px; font-size: 0.78rem; color: var(--muted-d); }
  .hero__legend i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; }
  @media (max-width: 760px) { .hero__legend { display: none; } .hero--dark { padding-top: 90px; } }
  .how__board { max-width: 760px; margin: 0 auto clamp(32px, 4vw, 52px); }
  .why { border-top: 2px solid var(--fg); padding-top: 18px; }
  .why__i { font-family: var(--display); font-style: italic; font-size: 1.4rem; color: var(--signal); }
  .aud__row { display: grid; grid-template-columns: 1fr 1.3fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--line); align-items: baseline; }
  .aud__row:last-child { border-bottom: 1px solid var(--line); }
  .aud__row p { margin: 0; color: var(--muted); font-size: 1.08rem; }
  @media (max-width: 700px) { .aud__row { grid-template-columns: 1fr; gap: 6px; } }
  .pf { display: flex; flex-direction: column; align-items: flex-start; }
  .pf--on { border-color: color-mix(in srgb, var(--signal) 45%, transparent); }
  .offer { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 5vw, 72px); padding: clamp(28px, 5vw, 64px); border-radius: 28px; background: var(--ink); color: var(--text-d); position: relative; overflow: hidden; }
  .offer::before { content: ''; position: absolute; inset: auto -10% -70% 45%; height: 130%; background: radial-gradient(closest-side, rgba(255, 91, 46, 0.32), transparent); pointer-events: none; }
  .offer .dim, .offer .eyebrow:not(.eyebrow--signal) { color: var(--muted-d); }
  .offer__ghost { border-color: var(--line-d); color: var(--text-d); }
  .offer__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; position: relative; }
  .offer__list li { display: grid; grid-template-columns: 40px 1fr; gap: 10px; padding: 15px 0; border-top: 1px solid var(--line-d); color: #e8e3d8; }
  .offer__list li span:first-child { font-family: var(--display); font-style: italic; color: var(--signal-2); }
  .offer__fine { grid-column: 1 / -1; margin: 0; font-size: 0.82rem; color: var(--muted-d); position: relative; }
  @media (max-width: 860px) { .offer { grid-template-columns: 1fr; } }
</style>

<script>
  import { reduced, ScrollTrigger } from '../lib/motion';
  const host = document.getElementById('net');
  // three.js loads after the page is readable; the glow shows until then
  if (host) {
    import('../lib/network').then(({ mountNetwork }) => {
      const net = mountNetwork(host, host, { reduced: reduced() });
      if (net) ScrollTrigger.create({ trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true, onUpdate: x => net.setProgress(x.progress) });
    });
  }
</script>
