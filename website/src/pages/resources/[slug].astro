---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { POSTS, type Post } from '../../data/posts';
import { site } from '../../site.config';

export function getStaticPaths() {
  return POSTS.map(p => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Post };
const fmt = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const next = POSTS.filter(x => x.slug !== p.slug).slice(0, 2);
const ld = { '@context': 'https://schema.org', '@type': 'Article', headline: p.title, datePublished: p.date, description: p.summary, publisher: { '@type': 'Organization', name: site.name } };
---
<Base title={p.title} description={p.summary} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero eyebrow={`${p.tag} · ${fmt(p.date)} · ${p.minutes} min read`} title={p.title} lead={p.summary} crumb={{ label: 'All insights', href: '/resources' }} />

  <section class="section" data-scene-trigger="light">
    <div class="wrap">
      <article class="prose">
        {p.body.map(b => {
          if ('h' in b) return <h2>{b.h}</h2>;
          if ('p' in b) return <p>{b.p}</p>;
          if ('q' in b) return <blockquote>{b.q}<br /><span class="src">{b.by}</span></blockquote>;
          return <ul>{b.list.map(li => <li>{li}</li>)}</ul>;
        })}
        {p.sources.length > 0 && (
          <>
            <h2>Sources</h2>
            <ul class="src">{p.sources.map(s => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ul>
          </>
        )}
      </article>
    </div>
  </section>

  <section class="section--tight" data-scene-trigger="light">
    <div class="wrap">
      <p class="eyebrow">Keep reading</p>
      <div class="grid g2" style="margin-top:18px">
        {next.map(n => <a class="card" href={`/resources/${n.slug}`}><h3 class="h-sm" style="font-weight:600">{n.title}</h3><p style="margin-top:8px">{n.summary}</p></a>)}
      </div>
    </div>
  </section>
  <div data-scene-trigger="dark"></div>
</Base>
