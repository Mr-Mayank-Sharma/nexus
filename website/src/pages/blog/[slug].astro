---
import Base from '../../layouts/Base.astro';
import PostCover from '../../components/PostCover.astro';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { POSTS, AUTHOR, type Post } from '../../data/posts';
import { site } from '../../site.config';

export function getStaticPaths() {
  return POSTS.map(p => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Post };
const fmt = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const anchor = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const headings = p.body.filter((b): b is { h: string } => 'h' in b).map(b => b.h);
const related = [...POSTS.filter(x => x.slug !== p.slug && x.tag === p.tag), ...POSTS.filter(x => x.slug !== p.slug && x.tag !== p.tag)].slice(0, 3);
const url = new URL(`/blog/${p.slug}`, Astro.site ?? 'https://example.com').toString();
// the product box goes after the second section, where the reader has the problem in mind
const ctaAfter = (() => { let n = 0; for (let i = 0; i < p.body.length; i++) { if ('h' in p.body[i] && ++n === 2) return i; } return Math.min(2, p.body.length - 1); })();
const ld = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Article', headline: p.title, description: p.summary, datePublished: p.date, author: { '@type': 'Organization', name: AUTHOR.name }, publisher: { '@type': 'Organization', name: site.name }, mainEntityOfPage: url, articleSection: p.tag },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: new URL('/blog', Astro.site ?? 'https://example.com').toString() },
      { '@type': 'ListItem', position: 2, name: p.title, item: url }] },
  ],
};
---
<Base scene="light" title={p.title} description={p.summary} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="rp" aria-hidden="true"><i data-rp></i></div>
  <article>
    <header class="ah" data-scene-trigger="light">
      <div class="wrap">
        <nav class="ah__crumb" aria-label="Breadcrumb"><a href="/blog">Blog</a> <span aria-hidden="true">/</span> <a href={`/blog?topic=${encodeURIComponent(p.tag)}`}>{p.tag}</a></nav>
        <h1 class="display h-lg" style="margin:18px 0 0;max-width:22ch">{p.title}</h1>
        <p class="lead" style="margin-top:18px">{p.summary}</p>
        <p class="ah__meta"><b>{AUTHOR.name}</b> · {fmt(p.date)} · {p.minutes} min read</p>
        <div class="ah__cover"><PostCover post={p} /></div>
      </div>
    </header>

    <div class="wrap ab">
      <aside class="ab__toc" aria-label="On this page">
        {headings.length > 0 && <><p class="ab__toch">On this page</p><ol>{headings.map(h => <li><a href={`#${anchor(h)}`}>{h}</a></li>)}</ol></>}
        <div class="ab__share">
          <p class="ab__toch">Share</p>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(p.title)}`} target="_blank" rel="noopener">X</a>
          <button type="button" data-copy={url}>Copy link</button>
        </div>
      </aside>

      <div class="prose ab__body">
        {p.body.map((b, i) => (
          <>
            {'h' in b ? <h2 id={anchor(b.h)}>{b.h}</h2>
              : 'p' in b ? <p>{b.p}</p>
              : 'q' in b ? <blockquote>{b.q}<br /><span class="src">{b.by}</span></blockquote>
              : <ul>{b.list.map(li => <li>{li}</li>)}</ul>}
            {i === ctaAfter && p.product && (
              <aside class="ab__cta not-prose">
                <span class="ab__ctak">In Nexus</span>
                <p>{p.product.line}</p>
                <a class="btn btn--signal" href={p.product.href}>{p.product.label} <span class="arr">→</span></a>
              </aside>
            )}
          </>
        ))}
        {p.sources.length > 0 && (
          <>
            <h2 id="sources">Sources</h2>
            <ul class="src">{p.sources.map(s => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ul>
          </>
        )}
        <div class="ab__author">
          <span class="ab__avatar" aria-hidden="true">N</span>
          <div><b>{AUTHOR.name}</b><p>{AUTHOR.role}. Figures from outside sources are linked; our own numbers come from Nexus running on development stores.</p></div>
        </div>
      </div>
    </div>
  </article>

  <section class="section--tight" data-scene-trigger="light">
    <div class="wrap">
      <h2 class="display h-md" style="margin:0 0 24px">Keep reading</h2>
      <div class="grid g3">{related.map(r => <PostCard post={r} />)}</div>
      <div style="margin-top:clamp(32px,5vw,56px)"><Newsletter /></div>
    </div>
  </section>
</Base>

<style>
  .rp { position: fixed; left: 0; right: 0; top: 0; height: 3px; z-index: 70; }
  .rp i { display: block; height: 100%; width: 0; background: var(--signal); }
  .ah { padding: clamp(48px, 7vw, 96px) 0 0; }
  .ah__crumb { font-size: 0.9rem; color: var(--muted); }
  .ah__crumb a:hover { color: var(--signal); }
  .ah__meta { margin: 20px 0 0; color: var(--muted); font-size: 0.95rem; }
  .ah__meta b { color: var(--fg); }
  .ah__cover { margin-top: clamp(28px, 4vw, 44px); border-radius: 22px; overflow: hidden; }
  .ab { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); padding-top: clamp(36px, 5vw, 64px); padding-bottom: clamp(24px, 4vw, 48px); }
  .ab__toc { position: sticky; top: 100px; align-self: start; font-size: 0.92rem; }
  .ab__toch { margin: 0 0 8px; font-weight: 650; }
  .ab__toc ol { list-style: none; margin: 0 0 28px; padding: 0; display: grid; gap: 6px; }
  .ab__toc ol a { color: var(--muted); }
  .ab__toc ol a:hover, .ab__toc ol a.is-on { color: var(--fg); }
  .ab__toc ol a.is-on { box-shadow: inset 2px 0 0 var(--signal); padding-left: 8px; }
  .ab__share { display: grid; gap: 4px; justify-items: start; }
  .ab__share a, .ab__share button { color: var(--muted); font-size: 0.9rem; padding: 0; }
  .ab__share a:hover, .ab__share button:hover { color: var(--signal); }
  .ab__cta { margin: 2em 0; padding: 22px 24px; border-radius: 18px; background: var(--ink); color: var(--text-d); display: grid; gap: 10px; justify-items: start; }
  .ab__cta p { margin: 0; color: #e8e3d8 !important; font-size: 1.05rem; }
  .ab__ctak { font-family: var(--display); font-style: italic; color: var(--signal-2); }
  .ab__cta a.btn { border-bottom: 0; color: #fff; }
  .ab__author { display: flex; gap: 14px; margin-top: 2.5em; padding-top: 1.5em; border-top: 1px solid var(--line); }
  .ab__author p { margin: 4px 0 0; font-size: 0.95rem; color: var(--muted) !important; }
  .ab__avatar { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--signal); color: #fff; font-family: var(--display); font-style: italic; font-size: 1.3rem; }
  @media (max-width: 900px) { .ab { grid-template-columns: 1fr; } .ab__toc { position: static; } .ab__toc ol { margin-bottom: 12px; } .ab__share { display: flex; gap: 16px; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-rp]');
  const body = document.querySelector<HTMLElement>('.ab__body');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.ab__toc ol a'));
  const heads = links.map(l => document.getElementById(decodeURIComponent(l.hash.slice(1)))).filter(Boolean) as HTMLElement[];
  const onScroll = () => {
    if (bar && body) {
      const r = body.getBoundingClientRect();
      bar.style.width = `${Math.min(100, Math.max(0, (-r.top + innerHeight * 0.3) / r.height * 100))}%`;
    }
    let cur = 0;
    heads.forEach((h, i) => { if (h.getBoundingClientRect().top < innerHeight * 0.35) cur = i; });
    links.forEach((l, i) => l.classList.toggle('is-on', i === cur));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(b => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; } catch { b.textContent = 'Copy failed'; }
    setTimeout(() => (b.textContent = 'Copy link'), 1600);
  }));
</script>
