#!/usr/bin/env bash
# Fast checks only (about a minute). The full suite is scripts/verify-all.sh.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/nexus-oms-frontend" && npm run lint --silent && npm run typecheck --silent && npm test --silent -- --run
cd "$ROOT" && python3 scripts/verify_docs.py
